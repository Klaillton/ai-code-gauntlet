{
  "name": "my-gauntlet-app",
  "strictness": "lenient",
  "allowSpecEdit": false,
  "allowDepsEdit": false,
  "gates": [
    { "id": "format", "command": "npm", "args": ["run", "format"] },
    { "id": "lint", "command": "npm", "args": ["run", "lint"] },
    { "id": "typecheck", "command": "npm", "args": ["run", "typecheck"] },
    { "id": "complexity", "command": "npm", "args": ["run", "complexity"] },
    { "id": "protect-specs", "command": "npm", "args": ["run", "protect-specs"] },
    { "id": "deps-lock", "command": "npm", "args": ["run", "deps-lock"] },
    { "id": "no-cheat", "command": "npm", "args": ["run", "no-cheat"] },
    { "id": "spec-sync", "command": "npm", "args": ["run", "spec-sync"] },
    { "id": "docs", "command": "npm", "args": ["run", "docs:check"] },
    { "id": "unit", "command": "npm", "args": ["run", "test:unit:coverage"] },
    { "id": "contract", "command": "npm", "args": ["run", "test:contract"] },
    { "id": "e2e", "command": "npm", "args": ["run", "test:e2e"] }
  ],
  "complexity": {
    "include": ["src/domain"],
    "max": 10
  },
  "allowlist": [
    {
      "kind": "test-harness",
      "method": "POST",
      "path": "/api/test/reset",
      "reason": "E2E harness GAUNTLET_E2E=1",
      "exemptFrom": ["openapi", "gherkin"],
      "owner": "klaillton",
      "expires": "2026-12-02"
    },
    {
      "kind": "static-ui",
      "method": "GET",
      "path": "/",
      "reason": "HTML shell",
      "exemptFrom": ["openapi"],
      "owner": "klaillton",
      "expires": "2026-12-02"
    }
  ],
  "contract": {
    "openapiPath": "openapi/openapi.yaml",
    "serverEntry": "src/server.ts",
    "port": 3456,
    "cases": [
      {
        "label": "GET /health",
        "method": "GET",
        "path": "/health",
        "expectedStatus": 200,
        "schemaPath": "/health",
        "schemaMethod": "get",
        "schemaStatus": "200"
      }
    ]
  },
  "agent": {
    "protectedGlobs": ["features/**/*.feature", "openapi/openapi.yaml"],
    "maxVerifyCycles": 5
  }
}

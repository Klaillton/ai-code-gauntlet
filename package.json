{
  "name": "ai-code-gauntlet",
  "version": "0.1.0",
  "private": true,
  "description": "Disciplined AI coding scaffold: Cucumber + Playwright + Vitest + OpenAPI + agent gates",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:contract": "tsx scripts/check-openapi.ts",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "verify": "tsx scripts/verify.ts",
    "agent:loop": "tsx scripts/agent-loop.ts",
    "prepare:browsers": "playwright install chromium"
  },
  "dependencies": {
    "hono": "^4.7.2",
    "@hono/node-server": "^1.14.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.51.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.0.8",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "js-yaml": "^4.1.0",
    "playwright": "^1.51.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}

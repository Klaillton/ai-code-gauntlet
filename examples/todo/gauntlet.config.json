{
  "name": "todo-example",
  "strictness": "strict",
  "allowSpecEdit": false,
  "allowDepsEdit": false,
  "complexity": {
    "include": ["src/domain"],
    "max": 10
  },
  "mutation": {
    "include": ["src/domain"],
    "threshold": 80,
    "timeoutMs": 90000
  },
  "gates": [
    {
      "id": "format",
      "command": "npm",
      "args": ["run", "format"]
    },
    {
      "id": "lint",
      "command": "npm",
      "args": ["run", "lint"]
    },
    {
      "id": "typecheck",
      "command": "npm",
      "args": ["run", "typecheck"]
    },
    {
      "id": "complexity",
      "command": "npm",
      "args": ["run", "complexity"]
    },
    {
      "id": "arch-bound",
      "command": "npm",
      "args": ["run", "arch-bound"]
    },
    {
      "id": "protect-specs",
      "command": "npm",
      "args": ["run", "protect-specs"]
    },
    {
      "id": "deps-lock",
      "command": "npm",
      "args": ["run", "deps-lock"]
    },
    {
      "id": "holes-review",
      "command": "npm",
      "args": ["run", "holes-review"]
    },
    {
      "id": "adr-lint",
      "command": "npm",
      "args": ["run", "adr-lint"]
    },
    {
      "id": "sdd-presence",
      "command": "npm",
      "args": ["run", "sdd-presence"]
    },
    {
      "id": "secrets-scan",
      "command": "npm",
      "args": ["run", "secrets-scan"]
    },
    {
      "id": "no-cheat",
      "command": "npm",
      "args": ["run", "no-cheat"]
    },
    {
      "id": "spec-sync",
      "command": "npm",
      "args": ["run", "spec-sync"]
    },
    {
      "id": "docs",
      "command": "npm",
      "args": ["run", "docs:check"]
    },
    {
      "id": "unit",
      "command": "npm",
      "args": ["run", "test:unit:coverage"]
    },
    {
      "id": "crap",
      "command": "npm",
      "args": ["run", "crap"]
    },
    {
      "id": "mutation",
      "command": "npm",
      "args": ["run", "test:mutation"]
    },
    {
      "id": "contract",
      "command": "npm",
      "args": ["run", "test:contract"]
    },
    {
      "id": "e2e",
      "command": "npm",
      "args": ["run", "test:e2e"]
    },
    {
      "id": "gherkin-mutation",
      "command": "npm",
      "args": ["run", "gherkin-mutation"]
    }
  ],
  "allowlist": [
    {
      "kind": "test-harness",
      "method": "POST",
      "path": "/api/test/reset",
      "reason": "E2E harness GAUNTLET_E2E=1",
      "exemptFrom": ["openapi", "gherkin"],
      "owner": "klaillton",
      "expires": "2027-06-02"
    },
    {
      "kind": "static-ui",
      "method": "GET",
      "path": "/",
      "reason": "HTML shell",
      "exemptFrom": ["openapi"],
      "owner": "klaillton",
      "expires": "2027-06-02"
    }
  ],
  "contract": {
    "openapiPath": "openapi/openapi.yaml",
    "serverEntry": "src/server.ts",
    "port": 3456,
    "cases": [
      {
        "label": "GET /health",
        "method": "GET",
        "path": "/health",
        "expectedStatus": 200,
        "schemaPath": "/health",
        "schemaMethod": "get",
        "schemaStatus": "200"
      },
      {
        "label": "POST /api/todos 201",
        "method": "POST",
        "path": "/api/todos",
        "body": {
          "title": "Contract todo"
        },
        "expectedStatus": 201,
        "schemaPath": "/api/todos",
        "schemaMethod": "post",
        "schemaStatus": "201",
        "save": {
          "as": "todoId",
          "from": "id"
        }
      },
      {
        "label": "GET /api/todos",
        "method": "GET",
        "path": "/api/todos",
        "expectedStatus": 200,
        "schemaPath": "/api/todos",
        "schemaMethod": "get",
        "schemaStatus": "200"
      },
      {
        "label": "POST /api/todos/{id}/complete",
        "method": "POST",
        "path": "/api/todos/{{todoId}}/complete",
        "expectedStatus": 200,
        "schemaPath": "/api/todos/{id}/complete",
        "schemaMethod": "post",
        "schemaStatus": "200"
      },
      {
        "label": "POST /api/todos 400",
        "method": "POST",
        "path": "/api/todos",
        "body": {
          "title": "   "
        },
        "expectedStatus": 400,
        "schemaPath": "/api/todos",
        "schemaMethod": "post",
        "schemaStatus": "400"
      }
    ]
  },
  "agent": {
    "protectedGlobs": [
      "features/**/*.feature",
      "openapi/openapi.yaml",
      "docs/holes-review/**/*.md"
    ],
    "maxVerifyCycles": 5
  },
  "allowHolesReviewSkip": false,
  "holesReview": {
    "implementationGlobs": ["src/**"],
    "artifactGlob": "docs/holes-review/**/*.md"
  },
  "adrLint": {
    "glob": "docs/adr/**/*.md"
  }
}
